{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/backend",
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020", "dom"],
    "types": ["node"],
    "skipLibCheck": true,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "src/browser-worker/**/*.ts",
    "src/browser/**/*.ts",
    "src/cancellation-manager/**/*.ts",
    "src/challenges/**/*.ts",
    "src/commerce/**/*.ts",
    "src/core/**/*.ts",
    "src/electron/**/*.ts",
    "src/event-bus/**/*.ts",
    "src/interfaces/**/*.ts",
    "src/mocks/**/*.ts",
    "src/models/**/*.ts",
    "src/monitor/**/*.ts",
    "src/orchestrator/**/*.ts",
    "src/persistence/**/*.ts",
    "src/profiles/**/*.ts",
    "src/retry-scheduler/**/*.ts",
    "src/shopify/**/*.ts",
    "src/state-machine/**/*.ts",
    "src/task-executor/**/*.ts",
    "src/task-registry/**/*.ts",
    "src/types/**/*.d.ts",
    "src/worker-pool/**/*.ts"
  ]
}
